{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimCheckBatch",
  "type": "object",
  "required": ["essay_id", "essay_path", "claims"],
  "properties": {
    "essay_id": { "type": "string" },
    "essay_path": { "type": "string" },
    "essay_url": { "type": "string" },
    "generated_at": { "type": "string" },
    "agent": { "type": "string" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "quote",
        "claim_type",
        "verdict",
        "confidence",
        "sources",
        "why"
      ],
      "properties": {
        "id": { "type": "string" },
        "quote": {
          "type": "string",
          "description": "Exact sentence or short span copied from the essay."
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "supported_in_text",
            "verifiable_external",
            "opinion",
            "anecdote"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "supported",
            "contradicted",
            "misleading",
            "unverifiable",
            "opinion"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "title": { "type": "string" },
              "quote": { "type": "string" }
            }
          }
        },
        "why": { "type": "string" }
      }
    }
  }
}
